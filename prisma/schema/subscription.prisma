/// Assinatura de billing MANUAL de um tenant (Fase 2 — sem gateway).
///
/// Uma linha por tenant (1:1, evolui in-place — trocar de plano atualiza a mesma
/// linha). A fonte da verdade do ACESSO continua sendo `Tenant.status` + `Tenant.plan`
/// (o gating lê deles); a Subscription é o registro de billing. Suspender a
/// assinatura seta `Tenant.status = SUSPENDED` (que já corta o login) em conjunto.
///
/// Acesso legítimo é só via `withAdmin` (adminProcedure, role app_admin BYPASSRLS),
/// como `plans`/`addons`. Ainda assim a tabela tem RLS backstop (ENABLE+FORCE +
/// policy `tenant_isolation` por `tenant_id`, migration 20260714120000): um
/// `withTenant` acidental sobre `subscription` sem filtro não lê o billing de
/// outro tenant. Sem campos de gateway (asaas/pix/boleto) — cobrança automática
/// é fase futura.
model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  /// FK real para o plano (fonte da verdade do plano do tenant). `Restrict`:
  /// o banco recusa apagar um plano em uso — defesa em profundidade além da
  /// checagem em `deletePlan`. O gating resolve os módulos a partir daqui.
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")

  /// Snapshot do preço na ativação, em centavos. Congela mesmo se o preço do
  /// plano mudar depois; o superadmin pode sobrescrever na ativação (desconto).
  amountCents Int @map("amount_cents")

  startedAt        DateTime  @default(now()) @map("started_at")
  /// Fim do período pago atual (vencimento). "Marcar pago" e o pagamento por QR
  /// empurram esta data.
  ///
  /// OBRIGATÓRIO desde o ADR 0061 (migration 20260802120000). Era nullable, e um
  /// vencimento nulo saía do radar do cron de vencimento — que filtra por
  /// `currentPeriodEnd < now` e nunca casa NULL. A assinatura ficava ativa e de
  /// graça para sempre, sem sinal nenhum. Não afrouxe isto de volta.
  currentPeriodEnd DateTime  @map("current_period_end")
  cancelReason     String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  /// Teste grátis em andamento (ADR 0061). CONCEDE os módulos do plano e NÃO
  /// conta como receita. `currentPeriodEnd` é o fim do teste: quando passa, cai
  /// no mesmo caminho de vencimento (PAST_DUE → carência → bloqueio), sem
  /// máquina paralela. Estender o teste de um tenant é empurrar essa data.
  ///
  /// Quem responde "dá acesso?" e "é receita?" é `lib/billing/subscription-status`,
  /// não um literal espalhado pelo código.
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// Configuração global da plataforma (linha única). Só o superadmin edita.
///
/// Existe porque o dono pediu controle do prazo de teste "geral e de cada tenant".
/// O geral é este `trialDays`; o de cada tenant é empurrar o `currentPeriodEnd`
/// da assinatura em TRIALING, que não precisa de campo novo.
///
/// Linha única garantida por CHECK no banco (`id = 'singleton'`) — não por
/// convenção. Tabela global, sem `tenant_id`: fora do escopo de RLS por tenant.
model PlatformSettings {
  id        String   @id @default("singleton")
  /// Dias de teste grátis de um tenant novo. 0 desliga o teste.
  trialDays Int      @default(7) @map("trial_days")

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("platform_settings")
}

/// Aviso de cobrança já disparado (ADR 0061). É a trava de idempotência do
/// dunning: sem ela, o cron diário reenviaria "sua assinatura venceu" todo dia
/// durante a carência inteira.
///
/// A chave única inclui `periodEnd` de propósito. Quando o tenant paga, o
/// vencimento avança e o mesmo tipo de aviso volta a ser possível no ciclo
/// seguinte — a trava é por CICLO, não para sempre.
///
/// Tabela global de billing (sem RLS de tenant, como `plans` e `subscriptions`):
/// só o cron e o superadmin escrevem, via `withAdmin`.
model SubscriptionNotification {
  id             String                 @id @default(uuid()) @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  kind           SubscriptionNoticeKind
  /// Vencimento do ciclo a que este aviso se refere.
  periodEnd      DateTime               @map("period_end")

  /// Quando cada canal confirmou o envio. `null` = ainda não saiu (a linha foi
  /// criada como reserva). O cron do dia seguinte tenta de novo o que ficou
  /// nulo, sem reenviar o que já saiu.
  emailSentAt    DateTime? @map("email_sent_at")
  whatsappSentAt DateTime? @map("whatsapp_sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([subscriptionId, kind, periodEnd])
  @@index([tenantId])
  @@map("subscription_notifications")
}

enum SubscriptionNoticeKind {
  /// O teste grátis acaba em poucos dias. Separado de `DUE_SOON` pela MENSAGEM,
  /// não pelo mecanismo: quem testa ainda não escolheu plano nem tem o que pagar.
  TRIAL_ENDING
  /// Vence em poucos dias (aviso preventivo).
  DUE_SOON
  /// Venceu; começou a carência.
  PAST_DUE
  /// A carência acaba amanhã.
  GRACE_ENDING
  /// Suspendemos o acesso aos módulos do plano.
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}
