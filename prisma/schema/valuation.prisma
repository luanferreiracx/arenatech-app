model DeviceValuation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  modelo          String
  armazenamento   String
  saudeBateria    String    @map("saude_bateria")
  valor           Decimal   @db.Decimal(10, 2)
  validadeDias    Int       @default(7) @map("validade_dias")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Índice único PARCIAL criado por SQL puro na migration
  // 20260807140000_valuation_unique_ativa (o Prisma não expressa
  // `WHERE deleted_at IS NULL` em @@unique). Impede duas linhas ATIVAS para a
  // mesma combinação — ver E8-4 na auditoria de 2026-08-07.
  @@index([tenantId, modelo])
  @@index([tenantId, modelo, armazenamento])
  @@map("device_valuations")
}
