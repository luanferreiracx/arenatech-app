/// Link de pagamento DePix: UM link fixo por tenant, reutilizável.
///
/// O cliente paga por /pay/<token> sem login (informa CPF/CNPJ, valor e confirma
/// titularidade). O operador pode mandar o valor já preenchido pela própria URL
/// (/pay/<token>?valor=150) — sem criar registro novo para isso.
///
/// ## Por que deixou de ser "um link por cobrança" (2026-08-08)
///
/// O modelo antigo criava um link descartável por cobrança: valor gravado,
/// expiração de 12h, `status PAID` e `walletTransactionId @unique` amarrando
/// "1 link = 1 pagamento". Isso impedia o caso que a operação precisa — um link
/// fixo, divulgado uma vez, que continua recebendo.
///
/// A rastreabilidade não se perde: ela nunca morou no link, e sim na
/// `TenantDepixTransaction` de cada pagamento (valor, pagador, txid on-chain).
/// O link é o endereço de cobrança; a transação é o registro do dinheiro.
model PaymentLink {
  id          String   @id @default(uuid()) @db.Uuid
  /// UM link por tenant: é o endereço de cobrança fixo dele.
  tenantId    String   @unique @map("tenant_id") @db.Uuid

  /// Token publico nao-adivinhavel da URL /pay/<token>.
  token       String   @unique

  /// Texto exibido ao cliente na tela de pagamento (ex.: referência da loja).
  description String?

  /// Desligar suspende o recebimento SEM perder o token — religar devolve o
  /// MESMO endereço, para não invalidar material já divulgado.
  active      Boolean  @default(true)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_links")
}
